diff --git a/src/bthome_ble/parser.py b/src/bthome_ble/parser.py
--- a/src/bthome_ble/parser.py
+++ b/src/bthome_ble/parser.py
@@ -402,6 +402,10 @@
         # identifier; consumers can map it to a model string if they know
